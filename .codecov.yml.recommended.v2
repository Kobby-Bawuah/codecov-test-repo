# Recommended Codecov Configuration (Updated based on real uploads)
# This configuration uses patterns verified against actual Codecov uploads

comment:
  layout: "header, files, footer"
  hide_project_coverage: false

# Ignore patterns - tested against real Codecov uploads
ignore:
  # Option 1: Strict - only migration directories (recommended for most cases)
  - "migrations/.*"
  
  # Option 2: Comprehensive - any file with "migrations" in path (uncomment if needed)
  # - ".*migrations.*"
  
  # Note: The pattern ".*/migrations/.*" does NOT work because coverage paths
  # are relative to each app directory, not the repository root.
  # Real paths are: "migrations/0001_initial.py" not "django/migrations/0001_initial.py"

flags:
  django:
    paths:
      - apps/django
    carryforward: true
  dashboard:
    paths:
      - apps/dashboard
    carryforward: true

# Additional ignore patterns (uncomment if needed):
# ignore:
#   - "migrations/.*"           # Migration files (already included above)
#   - "tests/.*"                # Test files
#   - ".*/__pycache__/.*"       # Python cache
#   - "manage.py"               # Django management
#   - "wsgi.py"                 # WSGI config

